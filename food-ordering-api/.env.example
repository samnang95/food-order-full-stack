# ==============================================================================
# Food Ordering API - Environment Configuration Template
# ==============================================================================
# Supported Flavors:
#   - dev     / development : .env.dev     (PORT 3000, DB: food-ordering)
#   - staging / staging     : .env.staging (PORT 3001, DB: food-ordering-staging)
#   - prod    / production  : .env.prod    (PORT 3000, DB: food-ordering)
#
# Run with specific flavor:
#   npm run dev            (runs dev flavor with nodemon)
#   npm run dev:staging    (runs staging flavor with nodemon)
#   npm run dev:prod       (runs prod flavor with nodemon)
#   npm run start:dev
#   npm run start:staging
#   npm run start:prod
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FLAVOR=prod

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Security & JWT Authentication
# Generate strong 64+ char secrets (e.g. openssl rand -base64 48)
JWT_SECRET=replace_with_strong_random_secret_string
REFRESH_TOKEN_SECRET=replace_with_another_strong_random_secret_string

# Cloudinary (Image & Dish Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Firebase Cloud Messaging (Optional)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
